# Names only. Run `pnpm setup:env` to create a local .env with generated dev secrets.
# Never commit .env. Production values live in the secret manager (docs/13).

NODE_ENV=development
APP_ENV=local

# --- docker compose (local) ---
POSTGRES_SUPERUSER_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
POSTGRES_PORT=5432
REDIS_PORT=6379
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- application (filled by setup:env from the values above) ---
# App role: no BYPASSRLS. Pooled host in Neon environments.
DATABASE_URL=
# Owner role / direct (non-pooled) host: migrations only.
DATABASE_MIGRATION_URL=
REDIS_URL=
S3_ENDPOINT=
S3_BUCKET=dairy-dev
