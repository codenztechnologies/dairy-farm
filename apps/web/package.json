  "dependencies": {
    "@dairy/contracts": "workspace:*",
    "@dairy/i18n": "workspace:*",
    "@dairy/theme": "workspace:*",
    "@dairy/ui": "workspace:*",
    "i18next": "26.5.10",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@dairy/config": "workspace:*",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "cross-env": "10.1.0"
