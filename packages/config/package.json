{
  "name": "@dairy/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared ESLint config (with project-specific rules) and tsconfig presets",
  "exports": {
    "./eslint": "./eslint/index.js",
    "./eslint/plugin": "./eslint/plugin.js",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./tsconfig/react-lib.json": "./tsconfig/react-lib.json",
    "./tsconfig/next.json": "./tsconfig/next.json",
    "./tsconfig/expo.json": "./tsconfig/expo.json"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test \"eslint/rules/*.test.js\""
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-unicorn": "79.0.0",
    "globals": "17.13.0",
    "typescript-eslint": "8.72.0"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "typescript": "6.0.3"
  }
}
