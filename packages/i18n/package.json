{
  "name": "@dairy/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Locale catalogs (en, ur), typed keys and i18next setup. Formatters arrive in E0.7.",
  "exports": {
    ".": "./src/index.ts",
    "./locales/*": "./locales/*"
  },
  "scripts": {
