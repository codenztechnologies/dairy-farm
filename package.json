{
  "name": "dairy-farm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "verify:full": "node scripts/verify.mjs --full",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:contrast": "node packages/theme/scripts/check-contrast.mjs",
    "check:tokens": "node packages/theme/scripts/gen-native-tokens.mjs --check",
    "gen:tokens": "node packages/theme/scripts/gen-native-tokens.mjs",
    "prepare": "husky",
    "setup:env": "node scripts/setup-env.mjs",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "pnpm --filter @dairy/ui storybook",
    "build:storybook": "pnpm --filter @dairy/ui build-storybook"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
